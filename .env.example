# ---- MySQL (from Hostinger Databases screen) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ---- Shared API key (acts like the old Supabase anon key) ----
# Any request to /api/* must send header:  x-api-key: <this value>
# Generate a long random string for this.
API_KEY=change_me_to_a_long_random_string

# ---- Outgoing email (password reset OTP, reminders) ----
# Gmail SMTP example — use a Gmail App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=your_email@gmail.com

# ---- Server ----
PORT=3000
